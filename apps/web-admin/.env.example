# Dedicated server-only PostgreSQL login; never prefix these variables NEXT_PUBLIC_.
DATABASE_URL=postgresql://church_app:change-me@127.0.0.1:5432/church
# Optional separate schema owner used only by npm run db:migrate.
MIGRATION_DATABASE_URL=postgresql://church_owner:change-me@127.0.0.1:5432/church
# Generate: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
SESSION_SECRET=
# Exact public origin, including scheme. HTTPS is required for production cookies.
APP_ORIGIN=http://127.0.0.1:3000

# Independent OTP hashing/encryption key; generate like SESSION_SECRET.
OTP_SECRET=
# SMTP is used as soon as SMTP_USER and SMTP_PASS are supplied.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Development-only private outbox fallback. Production requires SMTP credentials.
EMAIL_DELIVERY_MODE=file
