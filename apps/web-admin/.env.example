# Server-only connection used by the app, migrations, imports, and bootstrap.
# The login must have schema-owner permissions for npm run db:migrate.
# Never prefix database credentials with NEXT_PUBLIC_ or VITE_.
DATABASE_URL=postgresql://church_owner:change-me@127.0.0.1:5432/church
# Optional remote database, used only by database transfer scripts.
# Local-to-new: DATABASE_URL -> PRODUCTION_DATABASE_URL.
# Production-to-local: PRODUCTION_DATABASE_URL -> DATABASE_URL.
PRODUCTION_DATABASE_URL=
# Generate: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
# Keep this secret stable: sessions and push-subscription encryption depend on it.
SESSION_SECRET=
# Exact public origin, including scheme. HTTPS is required for production cookies.
# For phone testing, replace 127.0.0.1 with this computer's Wi-Fi IPv4 address.
# Development also allows localhost/127.0.0.1 on ports 3000 and 5173.
# Production origin checks match APP_ORIGIN exactly.
APP_ORIGIN=http://127.0.0.1:3000

# Protects the annual choir-membership and worship-event cron endpoints.
# Set when deploying either scheduled job; not needed for ordinary local development.
CRON_SECRET=

# SMTP is used as soon as SMTP_USER and SMTP_PASS are supplied.
# Host/port below are also the defaults when omitted.
# Port 465 uses implicit TLS; other ports require STARTTLS. SMTP_SECURE is not read.
# EMAIL_PROVIDER is not read: email delivery uses SMTP directly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Password / provider app password for SMTP_USER.
SMTP_PASS=
# Optional sender address; omit to use SMTP_USER. Set a real address if overriding.
SMTP_FROM=
# Development-only private outbox fallback. Production requires SMTP credentials.
# Only takes effect without SMTP credentials; remove if you always use SMTP.
EMAIL_DELIVERY_MODE=file
# Optional location for development email files; otherwise .local-data/mail-outbox.
# MAIL_OUTBOX_DIR=/absolute/path/to/private-mail-outbox

# Web Push: generate local credentials with npm run push:keys.
# Server-only. Never prefix the private key with NEXT_PUBLIC_ or VITE_.
# Remove all three if Web Push is not needed. Keep the existing key pair stable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI (mailto: or HTTPS) required when push is enabled.
VAPID_SUBJECT=mailto:admin@example.com

# Optional: false disables notifications about new public worship contributions.
# WORSHIP_CONTRIBUTION_NOTIFY_ENABLED=true

# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI are not used.
# This application does not implement Google OAuth.

# Opt-in timing logs contain route patterns and durations, never SQL or member data.
PERFORMANCE_LOGGING=false
# Defaults preserve the existing connection budget. Tune only after observing pool waits.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
