{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "mobile-client": {
      "root": "apps/mobile-client",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "web-admin": {
      "root": "apps/web-admin",
      "framework": "nextjs"
    }
  },
  "crons": [
    {
      "path": "/api/cron/annual-choir-memberships",
      "schedule": "0 17 28 2 *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "web-admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "mobile-client" }
    }
  ]
}
