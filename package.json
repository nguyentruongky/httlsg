    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
