{
  "name": "organization-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:admin": "npm run dev -w @org/admin",
    "d": "npm run dev -w @org/admin",
    "dev:mobile": "npm run dev -w @org/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prisma:build": "npm run build -w @org/admin && test -d apps/web-admin/.next/standalone",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html,mjs,webmanifest}\" \"packages/**/*.{ts,tsx,css,json}\" \"docs/*.md\" README.md package.json tsconfig.base.json",
    "import:believers": "python3 scripts/import-believers.py",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:bootstrap": "node --import tsx scripts/database.ts bootstrap",
    "db:import": "node --import tsx scripts/database.ts import",
    "db:local:setup": "node --import tsx scripts/local-database.ts setup",
    "db:local:start": "node --import tsx scripts/local-database.ts start",
    "db:local:stop": "node --import tsx scripts/local-database.ts stop",
    "db:migrate:local-to-new": "node scripts/migrate-local-database.mjs",
    "db:sync:production-to-local": "node scripts/sync-production-to-local.mjs",
    "calendar:deliver": "node --import tsx scripts/calendar-deliver.ts",
    "pwa:assets": "node scripts/pwa-assets.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "push:deliver": "node --import tsx scripts/push-deliver.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prisma": "8.0.0-rc.33",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "effect": "4.0.5"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5",
    "effect": "4.0.5"
  }
}
